// Multi-tenant event booking.
// Every tenant-owned row carries organizationId, and every read in
// src/server/repositories takes an organizationId, so queries are always tenant-scoped.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // CommonJS output: the default ESM output uses import.meta.url, which Jest cannot load.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  venues          Venue[]
  events          Event[]
  bookings        Booking[]
  idempotencyKeys IdempotencyKey[]
  memberships     Membership[]

  @@map("organizations")
}

model Venue {
  id             String @id @default(cuid())
  organizationId String
  name           String
  address        String
  city           String
  country        String @db.Char(2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([organizationId])
  @@map("venues")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id                 String      @id @default(cuid())
  organizationId     String
  venueId            String
  slug               String
  title              String
  summary            String
  description        String
  startsAt           DateTime
  endsAt             DateTime
  status             EventStatus @default(DRAFT)
  currency           String      @default("JPY") @db.Char(3)
  maxSeatsPerBooking Int         @default(6)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue        Venue        @relation(fields: [venueId], references: [id])
  sections     Section[]
  seats        Seat[]
  bookings     Booking[]

  // Slugs are unique per tenant, not globally: two organizers can both have "summer-live".
  @@unique([organizationId, slug])
  @@index([organizationId, status, startsAt])
  @@map("events")
}

model Section {
  id         String @id @default(cuid())
  eventId    String
  name       String
  // Price in the currency's minor unit. JPY has no minor unit, so 1 = ¥1.
  priceMinor Int
  sortOrder  Int    @default(0)

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats Seat[]

  @@unique([eventId, name])
  @@map("sections")
}

model Seat {
  id        String @id @default(cuid())
  eventId   String
  sectionId String
  row       String
  number    Int

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  section      Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@unique([sectionId, row, number])
  @@index([eventId])
  @@map("seats")
}

// PENDING ──paid──▶ CONFIRMED ──cancel──▶ CANCELLED (refunded if it was paid)
//    │                ▲
//    ├─cancel─▶ CANCELLED
//    └─hold expired─▶ EXPIRED ──paid late──▶ CONFIRMED if the seats are still free,
//                                            otherwise REFUNDED
enum BookingStatus {
  // Awaiting payment. Holds its seats until expiresAt.
  PENDING
  CONFIRMED
  CANCELLED
  // The hold ran out before payment; the seats were released.
  EXPIRED
  // Paid after the hold expired, but someone else had taken a seat by then.
  REFUNDED
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  eventId        String
  reference      String        @unique
  customerName   String
  customerEmail  String
  status         BookingStatus @default(CONFIRMED)
  totalMinor     Int
  // The customer's language ("en", "ja"): seat labels, emails and links use it.
  locale         String        @default("en")
  // Copied at booking time, so a cancelled booking still shows what was bought,
  // and a payment that arrives after the hold expired knows which seats to take back.
  seatLabels     String[]
  seatIds        String[]
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?

  // Payment. A PENDING booking holds its seats until expiresAt.
  expiresAt         DateTime?
  paymentProvider   String?
  checkoutSessionId String?   @unique
  checkoutUrl       String?
  paymentId         String?
  paidAt            DateTime?
  refundedAt        DateTime?

  // Door check-in by the organizer's staff.
  checkedInAt   DateTime?
  checkedInById String?
  checkedInBy   User?     @relation(fields: [checkedInById], references: [id], onDelete: SetNull)

  emails EmailMessage[]

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats          BookingSeat[]
  idempotencyKey IdempotencyKey?

  @@index([organizationId, eventId])
  // Finds stale holds to release.
  @@index([status, expiresAt])
  @@map("bookings")
}

// One row per seat held by an active booking.
// The unique constraint on seatId is what makes double booking impossible,
// even when two requests race: the second INSERT fails inside its transaction.
// Cancelling a booking deletes its rows, which releases the seats.
model BookingSeat {
  bookingId String
  seatId    String @unique

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@id([bookingId, seatId])
  @@map("booking_seats")
}

// A client-chosen key (the Idempotency-Key header, or a hidden field in the booking form)
// that made a booking. A retry with the same key returns that booking instead of booking
// again. The row is written in the same transaction as the booking, so a key exists if and
// only if its booking does. Failed requests leave no key, so they can be retried as is.
model IdempotencyKey {
  organizationId String
  key            String
  // SHA-256 of the request (event, customer, seats): the same key with a different
  // request is a client bug and is rejected instead of returning the old booking.
  requestHash    String
  bookingId      String   @unique
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Keys are scoped per tenant, like everything else.
  @@id([organizationId, key])
  @@map("idempotency_keys")
}

// Fixed-window rate limit counters, one row per limited key (for example
// "booking:ip:203.0.113.7"). See src/server/rate-limit.ts.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int

  @@map("rate_limits")
}

// ---- Organizer accounts ----

model User {
  id           String   @id @default(cuid())
  // Stored lowercased, so "Owner@…" and "owner@…" are the same account.
  email        String   @unique
  name         String
  // scrypt, with its parameters and salt in the string (see src/server/auth/password.ts).
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Membership[]
  sessions    Session[]
  checkIns    Booking[]

  @@map("users")
}

enum MemberRole {
  // Everything: sales, customer emails, CSV export, check-in.
  OWNER
  // Door staff: the booking list without emails, and check-in.
  STAFF
}

// Which organizers a user works for. Every dashboard query starts from a membership.
model Membership {
  userId         String
  organizationId String
  role           MemberRole
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// Database sessions. The cookie holds a random token; only its SHA-256 is stored, so a
// leaked database cannot be used to sign in.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---- Email (transactional outbox) ----

enum EmailStatus {
  PENDING
  SENT
  // Gave up after the maximum number of attempts.
  FAILED
}

// Emails to customers. A row is inserted in the same transaction as the booking change
// it reports, so a confirmed booking always gets its email and a rolled-back change
// never sends one. Delivery happens after the response (src/server/email/outbox.ts);
// the content is rendered then, so a configuration problem only delays the email.
model EmailMessage {
  id          String      @id @default(cuid())
  bookingId   String
  // booking-confirmed | booking-cancelled | payment-refunded
  template    String
  to          String
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  // A delivery run claims a message until then, so two runs never send it twice.
  lockedUntil DateTime?
  lastError   String?
  // Filled when the message is sent, as a record of what the customer received.
  subject     String?
  text        String?
  html        String?
  createdAt   DateTime    @default(now())
  sentAt      DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([bookingId])
  @@map("email_messages")
}
