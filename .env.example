# Copy to .env for local development: cp .env.example .env
DATABASE_URL="postgresql://app:app@localhost:5432/event_booking"

# Used by the integration tests (npm run test:integration). Never point this at real data:
# the tests truncate every table.
TEST_DATABASE_URL="postgresql://app:app@localhost:5432/event_booking_test"

# Absolute site URL for canonical links, Open Graph and the sitemap.
SITE_URL="http://localhost:3000"

# Used by the integration tests: Stripe's mock server from docker compose (npm run db:up).
STRIPE_MOCK_URL="http://localhost:12111"

# Optional: Stripe test-mode keys (live keys are refused). Without them, bookings use the
# built-in demo checkout. Forward webhooks locally with:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Signs the "manage your booking" links in emails. Required in production:
#   openssl rand -base64 32
# Development uses a fixed secret when this is unset.
# BOOKING_LINK_SECRET=""

# Optional: send emails with Resend. Without these, the booking page shows a demo inbox.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Seatline <tickets@your-domain.example>"
