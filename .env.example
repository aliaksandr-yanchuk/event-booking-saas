# Copy to .env for local development: cp .env.example .env
DATABASE_URL="postgresql://app:app@localhost:5432/event_booking"

# Used by the integration tests (npm run test:integration). Never point this at real data:
# the tests truncate every table.
TEST_DATABASE_URL="postgresql://app:app@localhost:5432/event_booking_test"

# Absolute site URL for canonical links, Open Graph and the sitemap.
SITE_URL="http://localhost:3000"
